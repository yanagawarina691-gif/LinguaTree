# ========== LinguaTree Backend 环境配置 ==========

# 服务端口
PORT=3000
NODE_ENV=development

# 默认安全作品集模式：只读虚构示例，不打开 SQLite、不下载、不调用 AI。
# 需要自己的交互式学习功能时明确改为 personal；不要分享个人模式口令。
APP_MODE=demo

# 个人演示，用户名固定为 learner。对外部署必须设随机口令（至少 24 字符）。
HOST=127.0.0.1
DEMO_PASSWORD=
# HTTPS 反向代理部署时填写对外来源，例如 https://your-demo.example.com（无路径）。
# 本机同源运行可留空。个人 API 脚本需发送此来源的 Origin 请求头。
PUBLIC_ORIGIN=
# 仅 personal 模式使用；父目录须预先存在。demo 模式完全忽略 DB_PATH。
# DB_PATH=./src/db/linguatree.db

# ========== 仅 personal 使用：LLM + VLM 配置（OpenAI 兼容接口）==========
# 通义千问 DashScope（国内直连，无需代理）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
VLM_MODEL=qwen-vl-max

# ========== ASR 语音识别配置 ==========
# provider: 'dashscope' (通义千问 Paraformer, 国内直连) 或 'openai' (Whisper, 需代理)
ASR_PROVIDER=dashscope
ASR_MODEL=paraformer-v2

# DashScope 原生 API（ASR 使用，非 OpenAI 兼容接口）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com

# ========== 视频处理 ==========
TEMP_DIR=./temp
MAX_VIDEO_DURATION=300
KEYFRAME_COUNT=5

# ========== 超时设置 ==========
ASR_TIMEOUT=120000
LLM_TIMEOUT=30000
PIPELINE_TIMEOUT=180000

# ========== 代理（可选，仅用 OpenAI 时需要）==========
# HTTP_PROXY=http://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7897
